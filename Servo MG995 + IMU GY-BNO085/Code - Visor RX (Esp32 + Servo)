/////////////////////////////////////////////////////////
//         ESP-NOW RX + HEAD TRACKING SERVOS           //
/////////////////////////////////////////////////////////

#include <WiFi.h>
#include <esp_now.h>
#include <esp_wifi.h>

#include <ESP32Servo.h>
#include <ESP32PWM.h>

/////////////////////////////////////////////////////////
// SETTINGS
/////////////////////////////////////////////////////////

#define ESPNOW_CHANNEL 1

/////////////////////////////////////////////////////////
// DATA STRUCTURE
/////////////////////////////////////////////////////////

typedef struct {

  float yaw;
  float pitch;

} DataPacket;

/////////////////////////////////////////////////////////
// GLOBALS
/////////////////////////////////////////////////////////

DataPacket latestData;

volatile bool newData = false;

/////////////////////////////////////////////////////////
// SERVOS
/////////////////////////////////////////////////////////

Servo servoYaw;
Servo servoPitch;

/////////////////////////////////////////////////////////
// CURRENT POSITIONS
/////////////////////////////////////////////////////////

float currentYaw = 90;
float currentPitch = 90;

/////////////////////////////////////////////////////////
// SERVO LIMITS
/////////////////////////////////////////////////////////

const int YAW_MIN = 5;
const int YAW_MAX = 175;

const int PITCH_MIN = 30;
const int PITCH_MAX = 150;

/////////////////////////////////////////////////////////
// RECEIVE CALLBACK
/////////////////////////////////////////////////////////

void onReceive(
  const esp_now_recv_info *info,
  const uint8_t *data,
  int len
) {

  if (len != sizeof(latestData)) {
    return;
  }

  memcpy(
    &latestData,
    data,
    sizeof(latestData)
  );

  newData = true;
}

/////////////////////////////////////////////////////////
// SETUP
/////////////////////////////////////////////////////////

void setup() {

  Serial.begin(115200);

  delay(2000);

  Serial.println();
  Serial.println("=================================");
  Serial.println("      HEAD TRACKING RX");
  Serial.println("=================================");

  /////////////////////////////////////////////////////////
  // WIFI
  /////////////////////////////////////////////////////////

  WiFi.disconnect(true);

  WiFi.mode(WIFI_STA);

  delay(500);

  esp_wifi_set_channel(
    ESPNOW_CHANNEL,
    WIFI_SECOND_CHAN_NONE
  );

  /////////////////////////////////////////////////////////
  // PRINT MAC
  /////////////////////////////////////////////////////////

  Serial.print("RX MAC: ");

  Serial.println(WiFi.macAddress());

  /////////////////////////////////////////////////////////
  // ESP-NOW
  /////////////////////////////////////////////////////////

  if (esp_now_init() != ESP_OK) {

    Serial.println("ESP-NOW INIT FAILED");

    return;
  }

  esp_now_register_recv_cb(onReceive);

  /////////////////////////////////////////////////////////
  // SERVOS
  /////////////////////////////////////////////////////////

  ESP32PWM::allocateTimer(0);

  servoYaw.setPeriodHertz(50);

  servoPitch.setPeriodHertz(50);

  servoYaw.attach(21, 500, 2500);

  servoPitch.attach(19, 500, 2500);

  /////////////////////////////////////////////////////////
  // CENTER SERVOS
  /////////////////////////////////////////////////////////

  servoYaw.write(90);

  servoPitch.write(90);

  delay(1000);

  Serial.println("RX READY");

  Serial.println("=================================");
}

/////////////////////////////////////////////////////////
// LOOP
/////////////////////////////////////////////////////////

void loop() {

  if (newData) {

    newData = false;

    /////////////////////////////////////////////////////////
    // READ DATA
    /////////////////////////////////////////////////////////

    float yaw = latestData.yaw;

    float pitch = latestData.pitch;

    /////////////////////////////////////////////////////////
    // MAP YAW
    /////////////////////////////////////////////////////////

    float yawServoPos = map(
      yaw,
      -90,
      90,
      YAW_MIN,
      YAW_MAX
    );

    /////////////////////////////////////////////////////////
    // INVERTED PITCH
    /////////////////////////////////////////////////////////

    float pitchServoPos = map(
      -pitch,
      -22,
      45,
      PITCH_MIN,
      PITCH_MAX
    );

    /////////////////////////////////////////////////////////
    // LIMITS
    /////////////////////////////////////////////////////////

    yawServoPos = constrain(
      yawServoPos,
      YAW_MIN,
      YAW_MAX
    );

    pitchServoPos = constrain(
      pitchServoPos,
      PITCH_MIN,
      PITCH_MAX
    );

    /////////////////////////////////////////////////////////
    // SMOOTHING
    /////////////////////////////////////////////////////////

    currentYaw +=
      (yawServoPos - currentYaw) * 0.12;

    currentPitch +=
      (pitchServoPos - currentPitch) * 0.12;

    /////////////////////////////////////////////////////////
    // MOVE SERVOS
    /////////////////////////////////////////////////////////

    servoYaw.write((int)currentYaw);

    servoPitch.write((int)currentPitch);

    /////////////////////////////////////////////////////////
    // DEBUG
    /////////////////////////////////////////////////////////

    Serial.print("Yaw: ");

    Serial.print(yaw);

    Serial.print(" | Pitch: ");

    Serial.print(pitch);

    Serial.print(" | ServoYaw: ");

    Serial.print(currentYaw);

    Serial.print(" | ServoPitch: ");

    Serial.println(currentPitch);
  }

  delay(5);
}
