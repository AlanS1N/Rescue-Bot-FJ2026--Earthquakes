/////////////////////// VISOR TX (IMU) ///////////////////////
#include <esp_now.h>
#include <WiFi.h>
#include <Wire.h>
#include <Adafruit_BNO08x.h>

Adafruit_BNO08x bno08x;

// MAC ESP32 !!
uint8_t receiverAddress[] = {0xE8, 0x6B, 0xEA, 0xCA, 0x37, 0xF4};

typedef struct {
  float yaw;
} Data;

Data data;

sh2_SensorValue_t sensorValue;

float offset = 0;
bool calibrated = false;

void setup() {
  Serial.begin(115200);

  WiFi.mode(WIFI_STA);
  Wire.begin(21, 22);
  Wire.setClock(100000);

  Serial.println("Inicializando IMU...");

  if (!bno08x.begin_I2C(0x4B)) {
    Serial.println("Intentando 0x4A...");
    if (!bno08x.begin_I2C(0x4A)) {
      Serial.println("No se encontró BNO08X");
      while (1);
    }
  }

  Serial.println("IMU lista!");

  bno08x.enableReport(SH2_ROTATION_VECTOR);

  if (esp_now_init() != ESP_OK) {
    Serial.println("Error ESP-NOW");
    return;
  }

  esp_now_peer_info_t peerInfo = {};
  memcpy(peerInfo.peer_addr, receiverAddress, 6);
  esp_now_add_peer(&peerInfo);
}

void loop() {
  if (bno08x.getSensorEvent(&sensorValue)) {

    if (sensorValue.sensorId == SH2_ROTATION_VECTOR) {

      float qx = sensorValue.un.rotationVector.i;
      float qy = sensorValue.un.rotationVector.j;
      float qz = sensorValue.un.rotationVector.k;
      float qw = sensorValue.un.rotationVector.real;

      // YAW (Left/Right)
      float yaw = atan2(2.0 * (qw*qz + qx*qy),
                        1 - 2.0 * (qy*qy + qz*qz)) * 180.0 / PI;

      // Automatic Initial Calibration
      if (!calibrated) {
        offset = yaw;
        calibrated = true;
      }

      data.yaw = yaw - offset;

      esp_now_send(receiverAddress, (uint8_t *)&data, sizeof(data));

      Serial.print("Yaw: ");
      Serial.println(data.yaw);
    }
  }

  delay(20); // 50 Hz
}



/////////////////////// VISOR RX (SERVO) ///////////////////////
#include <esp_now.h>
#include <WiFi.h>
#include <ESP32Servo.h>

Servo servo;

typedef struct {
  float yaw;
} Data;

Data incoming;

float filtered = 0;

void onReceive(const esp_now_recv_info *info, const uint8_t *data, int len) {
  if (len == sizeof(incoming)) {
    memcpy(&incoming, data, sizeof(incoming));

    // FILTER POR SERVO MOVEMENT
    filtered = 0.5 * filtered + 0.5 * incoming.yaw;

    // Range
    float angle = constrain(filtered, -90, 90);

    // Mapping
    int servoPos = map(angle, -90, 90, 0, 180);

    servo.write(servoPos);

    Serial.print("Servo: ");
    Serial.println(servoPos);
  }
}

void setup() {
  Serial.begin(115200);

  WiFi.mode(WIFI_STA);

  if (esp_now_init() != ESP_OK) {
    Serial.println("Error ESP-NOW");
    return;
  }

  esp_now_register_recv_cb(onReceive);

  servo.attach(18); // PIN18 OF ESP32

  Serial.println("Listo para recibir datos");
}

void loop() {}
