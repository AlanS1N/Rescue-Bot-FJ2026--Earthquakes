/////////////////////// VISOR RX (2 DOF GIMBAL) ///////////////////////
#include <esp_now.h>
#include <WiFi.h>
#include <ESP32Servo.h>

Servo servoYaw;   // Left/Right
Servo servoPitch; // Up/Down

typedef struct {
  float yaw;
  float pitch;
} Data;

Data incoming;

float filteredYaw = 0;
float filteredPitch = 0;

void onReceive(const esp_now_recv_info *info, const uint8_t *data, int len) {
  if (len == sizeof(incoming)) {
    memcpy(&incoming, data, sizeof(incoming));

    // FILTRO SUAVE (evita movimientos bruscos)
    filteredYaw   = 0.5 * filteredYaw   + 0.5 * incoming.yaw;
    filteredPitch = 0.5 * filteredPitch + 0.5 * incoming.pitch;

    // Limitar rango (ajústalo según tu IMU)
    float yaw   = constrain(filteredYaw,   -90, 90);
    float pitch = constrain(filteredPitch, -45, 45); // pitch suele ser menor

    // Mapear a servos
    int posYaw   = map(yaw,   -90, 90, 0, 180);
    int posPitch = map(pitch, -45, 45, 0, 180);

    // Mover servos
    servoYaw.write(posYaw);
    servoPitch.write(posPitch);

    Serial.print("Yaw: ");
    Serial.print(posYaw);
    Serial.print(" | Pitch: ");
    Serial.println(posPitch);
  }
}

void setup() {
  Serial.begin(115200);

  WiFi.mode(WIFI_STA);

  if (esp_now_init() != ESP_OK) {
    Serial.println("Error ESP-NOW");
    return;
  }

  esp_now_register_recv_cb(onReceive);

  // Pines
  servoYaw.attach(18);   // izquierda/derecha
  servoPitch.attach(5);  // arriba/abajo

  Serial.println("Listo para recibir datos");
}

void loop() {}
