// ============================================================
//        - x3 IBT-2        (H Bridge)
//        - x6 JGB37-520B   (Motor)
//        - Flysky FS iA10B (Rx)
//        - Flysky FS i6X   (Controller)
//
//     MAKE SURE TO BIND CORRECTLY THE CONTROLLER
// ============================================================

// ----------- IBT-2 LEFT -----------
const int RPWM_L = 25;
const int LPWM_L = 26;
const int R_EN_L = 27;
const int L_EN_L = 14;

// ----------- IBT-2 RIGHT -----------
const int RPWM_R = 33;
const int LPWM_R = 32;
const int R_EN_R = 13;
const int L_EN_R = 12;

// ----------- iBUS -----------
uint16_t chThrottle = 1500; // eje vertical
uint16_t chSteering = 1500; // eje horizontal

unsigned long ultimaLectura = 0;

// ----------- Read iBUS -----------
void leerIBus() {
  while (Serial2.available()) {
    static uint8_t buffer[32];
    static uint8_t indice = 0;

    uint8_t byteRecibido = Serial2.read();

    if (indice == 0 && byteRecibido != 0x20) continue;
    if (indice == 1 && byteRecibido != 0x40) { indice = 0; continue; }

    buffer[indice++] = byteRecibido;

    if (indice == 32) {
      uint16_t tempCH1 = buffer[2 + 0 * 2] | (buffer[3 + 0 * 2] << 8); // X
      uint16_t tempCH2 = buffer[2 + 1 * 2] | (buffer[3 + 1 * 2] << 8); // Y

      if (tempCH2 >= 800 && tempCH2 <= 2200) {
        chThrottle = (chThrottle * 0.7) + (tempCH2 * 0.3);
      }

      if (tempCH1 >= 800 && tempCH1 <= 2200) {
        chSteering = (chSteering * 0.7) + (tempCH1 * 0.3);
      }

      ultimaLectura = millis();
      indice = 0;
    }
  }
}

// ----------- Setup -----------
void setup() {
  Serial.begin(115200);

  Serial2.begin(115200, SERIAL_8N1, 16, -1);
  Serial2.setTimeout(0);

  // ENABLE
  pinMode(R_EN_L, OUTPUT);
  pinMode(L_EN_L, OUTPUT);
  digitalWrite(R_EN_L, HIGH);
  digitalWrite(L_EN_L, HIGH);

  pinMode(R_EN_R, OUTPUT);
  pinMode(L_EN_R, OUTPUT);
  digitalWrite(R_EN_R, HIGH);
  digitalWrite(L_EN_R, HIGH);

  // PWM ESP32
  ledcAttach(RPWM_L, 20000, 8);
  ledcAttach(LPWM_L, 20000, 8);

  ledcAttach(RPWM_R, 20000, 8);
  ledcAttach(LPWM_R, 20000, 8);

  Serial.println("Rover listo (mezcla 1 joystick)");
}

// ----------- Loop -----------
void loop() {
  leerIBus();

  // failsafe
  if (millis() - ultimaLectura > 300) {
    frenar();
    return;
  }

  int throttle = map(chThrottle, 1000, 2000, -255, 255);
  int steering = map(chSteering, 1000, 2000, -255, 255);

  // zonas muertas
  if (abs(throttle) < 40) throttle = 0;
  if (abs(steering) < 40) steering = 0;

  // mezcla diferencial
  int velIzq = throttle + steering;
  int velDer = throttle - steering;

  velIzq = constrain(velIzq, -255, 255);
  velDer = constrain(velDer, -255, 255);

  moverRobot(velIzq, velDer);
}

// ----------- Movement -----------
void moverRobot(int izq, int der) {

  // LEFT
  if (izq > 0) {
    ledcWrite(RPWM_L, izq);
    ledcWrite(LPWM_L, 0);
  } else {
    ledcWrite(RPWM_L, 0);
    ledcWrite(LPWM_L, abs(izq));
  }

  // RIGHT
  if (der > 0) {
    ledcWrite(RPWM_R, der);
    ledcWrite(LPWM_R, 0);
  } else {
    ledcWrite(RPWM_R, 0);
    ledcWrite(LPWM_R, abs(der));
  }
}

// ----------- BREAKS -----------
void frenar() {
  ledcWrite(RPWM_L, 0);
  ledcWrite(LPWM_L, 0);

  ledcWrite(RPWM_R, 0);
  ledcWrite(LPWM_R, 0);
}
