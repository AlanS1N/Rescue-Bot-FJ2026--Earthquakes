[Unit]
Description=Robot Vision Service
After=network.target graphical.target
Wants=graphical.target

[Service]
Type=simple
User=traxxas
WorkingDirectory=/home/traxxas/Desktop/rescue_robot/Final_old/robot_vision
ExecStart=/home/traxxas/Desktop/rescue_robot/Final_old/robot_vision/start_vision.sh
Environment=DISPLAY=:0
# If your user has an Xauthority file, provide its path so systemd service can connect to X
Environment=XAUTHORITY=/home/traxxas/.Xauthority
# Instruct the start script to show the OpenCV window
Environment=SHOW_WINDOW=true
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=robot-vision

[Install]
WantedBy=graphical.target
